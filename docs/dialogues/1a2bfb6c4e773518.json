  "variants": {
    "overhead-dialogue": [
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "What was I talking about, now?",
        "presentation": "overhead"
      },
      {
        "npc": "Weren't you going to tell me about the rumour?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Oh yeah, that was it!",
        "presentation": "overhead"
      },
      {
        "npc": "Carry on.",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "It's about the new family.",
        "presentation": "overhead"
      },
      {
        "npc": "That joined our horde?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "The very same!",
        "presentation": "overhead"
      },
      {
        "npc": "Oh my! Do tell.",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "I were hangin' out me washin'.",
        "presentation": "overhead"
      },
      {
        "npc": "Yes...",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "And I looked over at-",
        "presentation": "overhead"
      },
      {
        "npc": "I'm listening.",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Wait, we're being watched!",
        "presentation": "overhead"
      },
      {
        "npc": "We are?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Yes, a person over there.",
        "presentation": "overhead"
      },
      {
        "npc": "Where?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "No! Don't make eye contact.",
        "presentation": "overhead"
      },
      {
        "npc": "Oh my!",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "They're listening to us.",
        "presentation": "overhead"
      },
      {
        "npc": "A goblin folk?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Oh no! It's one of those tall people.",
        "presentation": "overhead"
      },
      {
        "npc": "Bizarre creatures for sure.",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Makes my skin crawl to see them.",
        "presentation": "overhead"
      },
      {
        "npc": "Why?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "So tall and neat.",
        "presentation": "overhead"
      },
      {
        "npc": "For sure, my dear.",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "I hope it doesn't come to speak with us.",
        "presentation": "overhead"
      },
      {
        "npc": "What a horrid thought!",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Horrid indeed, my dear.",
        "presentation": "overhead"
      },
      {
        "npc": "What should we do?",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "Let us carry on our conversation.",
        "presentation": "overhead"
      },
      {
        "npc": "Let's!",
        "presentation": "overhead"
      },
      {
        "type": "line",
        "speaker": "Naghead",
        "text": "So...",
        "presentation": "overhead"
      },
      {
        "npc": "Yes?",
        "presentation": "overhead"
      },
