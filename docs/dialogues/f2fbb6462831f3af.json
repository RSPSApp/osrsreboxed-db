{
  "default": "standard-dialogue",
  "variants": {
    "standard-dialogue": [
      {
        "npc": "Is there something I can help you with?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "I was given a challenge, what now?",
            "condition": "If the player has a Champion's scroll in their inventory:",
            "steps": [
              {
                "player": "I was given a challenge, what now?"
              },
              {
                "npc": "Hand it to me, and we'll get you started."
              }
            ],
            "id": "w1jfnz"
          },
          {
            "text": "What is this place?",
            "steps": [
              {
                "player": "What is this place?"
              },
              {
                "npc": "This is the champions' arena. The champions of various races use it to duel those they deem worthy of the honour. If you find a challenge scroll in your travels, bring it here to face your challenger."
              }
            ]
          },
          {
            "text": "Have you any rewards for me?",
            "steps": [
              {
                "player": "Have you any rewards for me?"
              },
              {
                "type": "condition",
                "text": "Before defeating any champions:",
                "steps": [
                  {
                    "npc": "No, you've not earned any."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "poglKl"
              },
              {
                "type": "condition",
                "text": "Before claiming a reward:",
                "steps": [
                  {
                    "npc": "Have a look in the chest by the Wall of Defeated Champions, on the north side of this gallery. I think you'll find something in there for you."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "gkKeiY"
              },
              {
                "type": "condition",
                "text": "While holding a Champion's lamp:",
                "steps": [
                  {
                    "npc": "You're holding it already. Go and rub your lamp."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "y-5v97"
              },
              {
                "type": "condition",
                "text": "If the player already has all rewards:",
                "steps": [
                  {
                    "npc": "I don't think I've got anything more for you."
                  }
                ],
                "id": "hCMMe-"
              }
            ]
          },
          {
            "text": "Nothing thanks.",
            "steps": [
              {
                "player": "Nothing thanks."
              }
            ]
          }
        ]
      }
    ],
    "standard-dialogue-talking-to-larxus-after-being-challenged-by-leon-d-cour": [
      {
        "npc": "Leon d'Cour has issued you a challenge. He has stated there will be no items allowed except those you're wearing. Do you want to accept the challenge?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Yes, let me at him!",
            "steps": [
              {
                "npc": "Your challenger is ready! Please go down through the trapdoor when you're ready."
              }
            ]
          },
          {
            "text": "No thanks, I'll pass.",
            "steps": [
              {
                "player": "No thanks, I'll pass."
              }
            ]
          },
          {
            "text": "Have you any rewards for me?",
            "steps": [
              {
                "type": "jump",
                "id": "I-U1Tj",
                "steps": [
                  {
                    "type": "call",
                    "branch": "jump-39bc4f5ff0332f5b"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
