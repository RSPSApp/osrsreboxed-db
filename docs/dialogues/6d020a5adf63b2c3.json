        "options": [
          {
            "text": "Dialogue 1",
            "steps": [
              {
                "npc": "YOU ARE A TERRIBLE BARD!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 2",
            "steps": [
              {
                "npc": "Don't give up your day job outerlander!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 3",
            "steps": [
              {
                "npc": "I thought somebody was murdering a cat!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 4",
            "steps": [
              {
                "npc": "You know, I actually quite liked that verse...",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 5",
            "steps": [
              {
                "npc": "That's kind of catchy. Irritating. But catchy.",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 6",
            "steps": [
              {
                "npc": "Hey, I've done that quest too!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 7",
            "steps": [
              {
                "npc": "I have produced better sounds in the outhouse!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 8",
            "steps": [
              {
                "npc": "Your song makes no sense outerlander!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 9",
            "steps": [
              {
                "npc": "What kind of bard are you anyway?",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 10",
            "steps": [
              {
                "npc": "I have met cows more musical than you!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 11",
            "steps": [
              {
                "npc": "When do you get to the good parts?",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 12",
            "steps": [
              {
                "npc": "would torture us so, outerlander?",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 13",
            "steps": [
              {
                "npc": "Truly, this is the worst sound I have ever heard!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 14",
            "steps": [
              {
                "npc": "looting and drinking part?",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 15",
            "steps": [
              {
                "npc": "Please tell me that was the last verse...",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 16",
            "steps": [
              {
                "npc": "Please... Kill me now...",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 17",
            "steps": [
              {
                "npc": "You call THAT singing?",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 18",
            "steps": [
              {
                "npc": "Never before have mine ears been so offended!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 19",
            "steps": [
              {
                "npc": "Worst. Bard. EVER.",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 20",
            "steps": [
              {
                "npc": "Please, ye gods! Make it stop!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 21",
            "steps": [
              {
                "npc": "If you stopped singing",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 22",
            "steps": [
              {
                "npc": "The screams of my dying comrades sound better!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 23",
            "steps": [
              {
                "npc": "My grandmother could do better, and she is dead!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 24",
            "steps": [
              {
                "npc": "I do such feats before breakfast!",
                "presentation": "overhead"
              }
            ]
          },
          {
            "text": "Dialogue 25",
            "steps": [
              {
                "npc": "Is your singing some kind of outerlander weapon?",
                "presentation": "overhead"
              }
            ]
          }
        ]
      }
