                "required": false,
                "nullable": false
              },
              "shared_table": {
                "description": "Name of the shared table rolled by this entry, as keyed in subtables.json.",
                "type": "string",
                "required": false,
                "nullable": false
              },
              "weight": {
                "description": "How many of the out_of slots this entry occupies.",
                "type": "integer",
                "required": false,
                "nullable": false,
                "min": 0
              },
              "out_of": {
                "description": "The denominator this entry is rolled against.",
                "type": "integer",
                "required": false,
                "nullable": false,
                "min": 1
              },
              "rarity": {
                "description": "Chance of a single roll landing on this entry (as a float out of 1.0).",
                "type": [
                  "float",
                  "integer"
                ],
                "required": false,
                "nullable": true,
                "min": 0
              },
              "rarity_raw": {
                "description": "The raw wiki rarity, when it could not be resolved to a numeric rate.",
                "type": "string",
                "required": false,
                "nullable": false
              },
              "assumed_rarity": {
                "description": "If the rate is a convention for a word rarity ('Common', 'Rare') rather than wiki data.",
                "type": "boolean",
                "required": false,
                "nullable": false
              },
              "weight_basis": {
                "description": "'conditional_pool' conditions relative resource weights on guaranteed fallback; 'remainder' when the weight is the slots the pool's other rows and shared table accesses leave, because the published rate also counts those tables' coins.",
                "type": "string",
                "allowed": [
                  "remainder",
                  "conditional_pool"
                ],
                "required": false,
                "nullable": false
              },
              "published_rarity": {
                "description": "The wiki's published rate before exact pool normalization or inclusive coin-rate resolution.",
                "type": "string",
                "required": false,
                "nullable": false
              },
              "noted": {
                "description": "If the drop is noted (the wiki quantity ends in \"(noted)\").",
                "type": "boolean",
                "required": false,
                "nullable": false
              },
              "clue_scroll_box": {
                "description": "If the drop arrives as a clue scroll box.",
                "type": "boolean",
                "required": false,
                "nullable": false
              },
              "section": {
                "description": "The wiki subsection the drop was listed under.",
                "type": "string",
                "required": false,
                "nullable": false
              },
              "notes": {
                "description": "Wiki footnotes attached to the drop, such as quest or area requirements.",
                "type": "list",
                "required": false,
                "nullable": false,
                "schema": {
                  "type": "string"
                }
              },
              "roll_count_weights": {
                "type": "list",
                "schema": {
                  "type": "dict",
                  "schema": {
                    "rolls": {
                      "type": "integer",
                      "min": 1,
                      "required": true
                    },
                    "weight": {
                      "type": "integer",
                      "min": 1,
                      "required": true
                    }
                  }
                }
              },
              "unresolved_roll_count": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
